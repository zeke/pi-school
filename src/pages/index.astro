import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

export const prerender = true;

const lessons = (await getCollection("lessons"))
	.sort((a, b) => a.data.order - b.data.order);
---

<Base
  title={undefined}
  description="A free, self-paced course for learning Pi, the minimal agent harness."
>
  <h1 class="text-2xl font-semibold mb-2">Pi School</h1>
  <p class="text-gray-600 dark:text-stone-400 mb-8">
    A free, self-paced course for learning <a href="https://pi.dev" class="theme-link underline">Pi</a>, the minimal agent harness.
  </p>

  <h2 class="text-xs font-mono uppercase tracking-wider text-gray-500 dark:text-stone-500 mb-4">
    Lessons
  </h2>
  <ol class="divide-y divide-gray-200 dark:divide-stone-800">
    {lessons.map((lesson) => (
      <li class="py-3">
        <a href={`/lessons/${lesson.data.slug}`} class="lesson-link group flex min-w-0 items-center gap-3">
          <span class="text-gray-400 dark:text-stone-600 font-mono text-sm shrink-0">
            {String(lesson.data.order).padStart(2, "0")}
          </span>
          <span class="min-w-0">
            <span class="lesson-title font-medium transition-colors block">{lesson.data.title}</span>
            <span class="text-sm text-gray-500 dark:text-stone-500">{lesson.data.description}</span>
          </span>
        </a>
      </li>
    ))}
  </ol>
</Base>
