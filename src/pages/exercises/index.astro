import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

export const prerender = true;

const exercises = (await getCollection("exercises")).sort(
	(a, b) => a.data.order - b.data.order,
);
---

<Base title="Exercises" description="Hands-on projects where you apply what you've learned in Pi School to build real things.">
  <div class="mb-6">
    <a href="/" class="text-sm text-gray-500 dark:text-stone-500 hover:text-gray-700 dark:hover:text-stone-300 transition-colors">
      &larr; All lessons
    </a>
  </div>

  <header class="mb-8">
    <h1 class="text-3xl font-bold">Exercises</h1>
    <p class="text-gray-600 dark:text-stone-400 mt-2">
      Hands-on projects where you apply what you've learned to build real things.
      Work through them in any order, once you've finished the lessons.
    </p>
  </header>

  <ol class="divide-y divide-gray-200 dark:divide-stone-800">
    {exercises.map((exercise) => {
      const href = `/exercises/${exercise.data.slug}`;
      return (
        <li data-exercise-slug={exercise.data.slug}>
          <div class="exercise-row flex flex-col gap-3 py-3 transition-colors sm:flex-row sm:items-center sm:justify-between">
            <a href={href} class="exercise-link group flex min-w-0 items-center gap-3">
              <span
                class="exercise-status flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-gray-300 bg-gray-100/70 text-white dark:border-stone-700 dark:bg-stone-900/70"
                aria-hidden="true"
              >
                <span class="exercise-status-dot h-2 w-2 rounded-full bg-gray-400 dark:bg-stone-500"></span>
                <span class="exercise-check hidden h-full w-full items-center justify-center text-xs font-bold leading-none">&#10003;</span>
              </span>
              <div class="min-w-0">
                <h3 class="exercise-title font-medium transition-colors">{exercise.data.title}</h3>
                <p class="exercise-description mt-0.5 text-sm text-gray-500 dark:text-gray-500">{exercise.data.description}</p>
              </div>
            </a>
          </div>
        </li>
      );
    })}
  </ol>
</Base>
