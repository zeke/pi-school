import { getCollection } from "astro:content";

interface Props {
	title?: string;
	description?: string;
}

const {
	title,
	description = "Learn to use Pi, the minimal agent harness.",
} = Astro.props;
const pageTitle = title ? `${title} | Pi School` : "Pi School";

const lessons = (await getCollection("lessons")).sort((a, b) => a.data.order - b.data.order);
const exercises = (await getCollection("exercises")).sort((a, b) => a.data.order - b.data.order);
const currentPath = Astro.url.pathname;

const secondaryLinks = [
	{ href: "/about", label: "About" },
	{ href: "/tips", label: "Tips" },
	{ href: "/cheatsheet", label: "Cheatsheet" },
	{ href: "/glossary", label: "Glossary" },
	{ href: "/contributing", label: "Contributing" },
	{ href: "/troubleshooting", label: "Troubleshooting" },
];
